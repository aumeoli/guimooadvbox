PORT=3000

# AdvBox API (https://api.softwareadvbox.com.br/docs)
ADVBOX_BASE_URL=https://app.advbox.com.br/api/v1
ADVBOX_TOKEN=SEU_TOKEN_AQUI

# IDs fixos da conta AdvBox — rode `npm run settings` depois de configurar o token acima
# para descobrir esses valores (eles são específicos da sua conta).
# stages_id e type_lawsuits_id NÃO entram aqui: são resolvidos por card, a partir
# dos campos personalizados #8902-#8905 do Guimoo (veja src/settingsCache.js).
ADVBOX_USERS_ID=
ADVBOX_CUSTOMERS_ORIGINS_ID=

# Guimoo API (https://integracao.agendasistemacrm.com.br/api/v1)
GUIMOO_BASE_URL=https://integracao.agendasistemacrm.com.br/api/v1
GUIMOO_API_KEY=SUA_API_KEY_AQUI

# IDs das conexões de WhatsApp no Guimoo (GET /whatsapp/conexoes)
GUIMOO_WHATSAPP_ID_COMERCIAL=27623
GUIMOO_WHATSAPP_ID_POSVENDAS=26946

# Etapa do Guimoo que deve disparar a integração. O webhook "Nova Movimentação"
# não informa o funil, só o estágio (estagio_novo.id/nome) — por isso só isso é checado.
GUIMOO_TARGET_STAGE_ID=82092
GUIMOO_TARGET_STAGE_NAME=ADVBOX

# IDs dos campos personalizados da negociação (GET /crm/campos-personalizados).
# Os valores abaixo já são o default no código — só sobrescreva se mudar no Guimoo.
GUIMOO_FIELD_ID_CPF=8919
GUIMOO_FIELD_ID_GRUPO_ACAO=8902
GUIMOO_FIELD_ID_TIPO_ACAO=8903
GUIMOO_FIELD_ID_FASE=8904
GUIMOO_FIELD_ID_ETAPA=8905

# Opcional: se o Guimoo permitir configurar um header/segredo compartilhado
# no webhook, defina aqui e o serviço vai validar toda requisição recebida.
GUIMOO_WEBHOOK_SECRET=

# ZapSign API (https://docs.zapsign.com.br) — usado pelo relatório diário
ZAPSIGN_BASE_URL=https://api.zapsign.com.br/api/v1
ZAPSIGN_TOKEN=SEU_TOKEN_AQUI

# Meta Ads — Graph API direta (sem Windsor.ai) — usado pelo relatório diário
META_ACCESS_TOKEN=SEU_TOKEN_DE_SYSTEM_USER_AQUI
META_AD_ACCOUNT_ID=1418512002471738

# Relatório diário por WhatsApp (Meta + CRM + ZapSign + AdvBox das últimas 24h)
DAILY_REPORT_NUMBERS=5592981084871,559284678778
DAILY_REPORT_CRON=0 18 * * *
DAILY_REPORT_TZ=America/Manaus
# segredo pra proteger o endpoint GET /daily-report/run (defina um valor forte)
DAILY_REPORT_SECRET=
